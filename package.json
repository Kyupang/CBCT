{
  "name": "dicom-web-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5190 --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "phantom": "vite-node scripts/gen-phantom.ts",
    "screens": "node scripts/screens.mjs",
    "fetch-samples": "node scripts/fetch-samples.mjs",
    "inspect": "vite-node scripts/inspect-series.ts",
    "s3": ".tools\\weed.exe server -dir=.data/seaweed -ip=127.0.0.1 -s3 -s3.port=8333 -s3.config=cloud/s3.json -s3.allowedOrigins=http://localhost:5190 -master.port=9333 -volume.port=8081 -filer.port=8888",
    "api": "vite-node cloud/main.ts",
    "upload": "vite-node cloud/uploader.ts --"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "dicom-parser": "^1.8.21",
    "fastify": "^5.12.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
